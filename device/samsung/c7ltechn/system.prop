# System properties for Samsung Galaxy C7 (SM-C7000 / c7ltechn) — LineageOS 16.0
# Values verified against stock build C7000ZCS3CRJ1 (Android 8.0.0) + cm-14.1 tree

# RIL (Samsung sec-ril, dual SIM)
rild.libpath=/system/lib64/libsec-ril.so
rild.libpath2=/system/lib64/libsec-ril-dsds.so
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so
vendor.sec.rild.libpath2=/vendor/lib64/libsec-ril-dsds.so
ro.telephony.default_network=9,1
persist.radio.multisim.config=dsds
ro.multisim.simslotcount=2
ro.radio.noril=no
persist.radio.jbims=1
persist.radio.custom_ecc=1
persist.radio.tdscdma_present=1
persist.radio.sib16_support=1
persist.radio.apm_sim_not_pwdn=1
persist.radio.add_power_save=1
persist.radio.lte_vrte_ltd=1
persist.radio.new.profid=true
persist.data.mode=concurrent
persist.data.dpm.enable=true
persist.data.dropssdp=false
persist.data.ibfc.enable=true
persist.data.netmgrd.qos.enable=false
persist.cne.feature=0
ro.use_data_netmgrd=true
telephony.lteOnCdmaDevice=1
DEVICE_PROVISIONED=1

# Audio
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.fluence.voicerec=false
persist.vendor.audio.fluence.speaker=true
vendor.audio.offload.buffer.size.kb=64
audio.offload.min.duration.secs=30
audio.offload.video=true
vendor.audio.offload.track.enable=true
audio.deep_buffer.media=true
vendor.audio.offload.multiaac.enable=true
vendor.audio.offload.passthrough=false
vendor.audio.hw.aac.encoder=true
ro.vendor.audio.sdk.fluencetype=none
ro.vendor.audio.sdk.ssr=false
vendor.audio.safx.pbe.enabled=true
vendor.audio.parser.ip.buffer.size=262144
vendor.audio.playback.mch.downsample=true
vendor.audio.use.sw.alac.decoder=true
vendor.audio.use.sw.ape.decoder=true
persist.speaker.prot.enable=false
use.qti.sw.alac.decoder=true
use.qti.sw.ape.decoder=true
audio.parser.ip.buffer.size=262144
audio.safx.pbe.enabled=true
audio.dolby.ds2.enabled=true
persist.vendor.audio.hifi.int_codec=true
persist.vendor.audio.speaker.prot.enable=false
ro.config.ringtone=Over_the_Horizon.ogg
ro.config.notification_sound=Skyline.ogg
ro.config.alarm_alert=Morning_Flower.ogg

# Display
ro.sf.lcd_density=420
ro.qualcomm.cabl=2
debug.sf.enable_hwc_vds=1
debug.sf.latch_unsignaled=1
debug.egl.hw=0
vendor.display.enable_default_color_mode=1

# Media
vidc.debug.perf.mode=1
media.sf.omx-flags.enable-widevine=true

# Memory / misc
ro.config.low_ram=false
ro.config.zram=false
ro.config.dha_cached_min=4
ro.config.dha_cached_max=10
ro.config.dha_empty_min=8
ro.config.dha_empty_max=16
ro.config.dha_empty_init=16
ro.config.dha_lmk_array=8940,11649,14359,18017,27768,38398
persist.sys.ssr.restart_level=3

# USB / misc
persist.sys.usb.config=none
dev.usbsetting.embedded=on
ro.build.scafe.version=2018A
