<?xml version="1.0" encoding="UTF-8"?>
<!--
  LineageOS 16.0 local manifest for Samsung Galaxy C7 (SM-C7000 / c7ltechn / MSM8953)

  Usage (in the CI workflow this is copied to .repo/local_manifests/):
    repo init -u https://github.com/LineageOS/android.git -b lineage-16.0 -depth 1
    cp manifest/c7ltechn-16.0.xml .repo/local_manifests/
    repo sync -c -j8 -no-tags
-->
<manifest>

  <remote  name="galaxy-msm8953"
           fetch="https://github.com/Galaxy-MSM8953" />

  <remote  name="c7ltechn"
           fetch="https://github.com/AwdndWindowsServer" />

  <!--
    Shrink the sync: remove emulator/generic devices and Apple-only prebuilts
    that are unused for a c7ltechn build (all verified present in the
    lineage-16.0 default manifest).
  -->
  <remove-project name="device/generic/mini-emulator-arm64" />
  <remove-project name="device/generic/mini-emulator-x86" />
  <remove-project name="device/generic/mini-emulator-x86_64" />
  <remove-project name="device/generic/qemu" />
  <remove-project name="device/generic/x86" />
  <remove-project name="device/generic/x86_64" />
  <remove-project name="platform/prebuilts/android-emulator" />
  <remove-project name="platform/prebuilts/clang/host/darwin-x86" />
  <remove-project name="platform/prebuilts/gcc/darwin-x86/host/i686-apple-darwin-4.2.1" />
  <remove-project name="platform/prebuilts/gcc/darwin-x86/arm/arm-linux-androideabi-4.9" />
  <remove-project name="platform/prebuilts/gcc/darwin-x86/aarch64/aarch64-linux-android-4.9" />
  <remove-project name="platform/prebuilts/gcc/darwin-x86/x86/x86_64-linux-android-4.9" />
  <remove-project name="platform/prebuilts/gdb/darwin-x86" />
  <remove-project name="platform/prebuilts/go/darwin-x86" />
  <remove-project name="platform/prebuilts/python/darwin-x86/2.7.5" />
  <remove-project name="platform/prebuilts/gradle-plugin" />
  <remove-project name="platform/prebuilts/libs/libedit" />
  <remove-project name="platform/prebuilts/maven_repo/android" />
  <remove-project name="platform/sdk" />
  <!-- webview prebuilts fail to check out (pinned-SHA + shallow clone on
       submodule-style repos); all four variants removed. The build may need
       WebView re-added later (e.g. building it or shipping a prebuilt apk). -->
  <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_arm" />
  <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_arm64" />
  <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_x86" />
  <remove-project name="LineageOS/android_external_chromium-webview_prebuilt_x86_64" />

  <!-- c7ltechn device tree + vendor tree (separate repos — the monorepo
       double-checkout made the product name ambiguous to the build) -->
  <project path="device/samsung/c7ltechn" name="c7ltechn-los16" remote="c7ltechn" revision="main" />
  <project path="vendor/samsung/c7ltechn" name="c7ltechn-vendor" remote="c7ltechn" revision="main" />

  <!--
    Kernel: LineageOS-16.0 adapted Samsung msm8953 kernel.
    staging/lineage-16.0-chn contains lineageos_c7ltechn_defconfig + c7lte_chn_open_defconfig.
  -->
  <project path="kernel/samsung/msm8953" name="android_kernel_samsung_msm8953" remote="galaxy-msm8953" revision="staging/lineage-16.0-chn" />

  <!--
    If the build reports missing repos, add them here, e.g.:
    <project path="device/qcom/common" name="LineageOS/android_device_qcom_common" revision="lineage-16.0" />
    <project path="device/samsung/qcom-common" name="LineageOS/android_device_samsung_qcom-common" revision="lineage-16.0" />
    <project path="hardware/samsung" name="LineageOS/android_hardware_samsung" revision="lineage-16.0" />
    <project path="external/sony/boringssl-compat" name="LineageOS/android_external_sony_boringssl-compat" revision="lineage-16.0" />
  -->

</manifest>
